[Unit]
Description=Agentlings elevated CLI metadata for desktop UID %i
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/agentlings-observer/observer.py --uid %i
Restart=on-failure
RestartSec=3
RuntimeDirectory=agentlings-observer-%i
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
ReadWritePaths=/run/agentlings-observer-%i

[Install]
WantedBy=multi-user.target
